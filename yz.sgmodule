#!name = YZU Portal 轉址 A→B
#!desc = 攔截 /NewPortalMaui/api/Auth/RSAkeybyAppID (AppID=MauiYzu20250930)，改送 /NewPortal/api/Auth/RSAkeybyAppID (AppID=XamPrismYzu20180206)，並把 B 的回應帶回給 A
#!category = 自訂
#!system = ios,mac

[Script]
YZU-RSAkey-Rewrite = type=http-request, pattern=^https:\/\/portalx\.yzu\.edu\.tw\/NewPortalMaui\/api\/Auth\/RSAkeybyAppID, requires-body=1, script-path=https://raw.githubusercontent.com/huanattw/scripts/refs/heads/main/yzu-newportal-maui.js

[MITM]
hostname = %APPEND% portalx.yzu.edu.tw
